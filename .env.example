# ──────────────────────────────────────────────────────────────
# LTZY-API 环境配置示例
#
# 用法：复制成 .env 再改。安装向导会自动生成 .env，通常不需要手动创建。
#
# 注意：
#   1. 这个文件里的值只是示例，不要直接把 .env.example 改名为 .env 用
#   2. 已有的环境变量（systemd Environment= / docker -e）优先级高于 .env
#   3. .env 含密码，权限必须 600，且不要提交到版本库
# ──────────────────────────────────────────────────────────────

# ── HTTP 服务 ──
# 生产环境用 nginx 反代时只监听回环地址，不要暴露到公网
APP_HOST=127.0.0.1
APP_PORT=3000

# 对外站点地址（生成登录链接、支付回调地址用，末尾不要带斜杠）
SITE_URL=https://api.example.com

# ── 数据库（只支持 PostgreSQL）──
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ltzy
DB_USERNAME=ltzy
DB_PASSWORD=

# 连接池大小。PG 默认 max_connections=100，
# 多实例部署时各实例之和不能超过它，否则会 "too many clients"
DB_POOL_SIZE=16
DB_POOL_WAIT_TIMEOUT=2.0

# ── 中继 ──
# 上游请求硬超时（秒）。到点即中断，即使上游还在排队
RELAY_TIMEOUT=300
# 失败重试次数（含首次）
RETRY_TIMES=3

# ── 日志 ──
# debug / info / warn / error
LOG_LEVEL=info
LOG_STDOUT=true
LOG_RETENTION_DAYS=180

# ── 业务开关 ──
# 是否允许无密钥调用免费模型。
# 默认关闭：匿名流量会吃光免费池，而且计费链路无法定位到具体用户
FREE_ANONYMOUS_ENABLED=false
# 是否开放注册
REGISTER_ENABLED=true

# ── 支付（易支付 epay 协议）──
PAYMENT_ENABLED=false
PAYMENT_GATEWAY=https://your-epay-gateway.example.com
PAYMENT_PID=
PAYMENT_KEY=
# 留空则按 SITE_URL 自动拼
PAYMENT_NOTIFY_URL=
PAYMENT_RETURN_URL=

# ── 网关级提示词包装（可选，默认关闭）──
# 只对指定模型生效，免费池的模型永远不进这个名单
JB_ENABLED=false
JB_MODELS=

# ── 自定义允许的 Host（可选）──
# 逗号分隔。用于反代场景下校验 Host 头，防止 Host 注入
SITE_ALLOWED_HOSTS=
